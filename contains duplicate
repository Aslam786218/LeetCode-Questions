# Solution using the set()

class Solution:
    def containsDuplicate(self, nums):
        seen = set()

        for num in nums:
            if num in seen:
                return True

            seen.add(num)

        return False

# creating object and calling function

nums = [1, 2, 3, 1]
solution = Solution()
result = solution.containsDuplicate(nums)
print(result)



# Solution using the dictionary

class Answer:
    def containsDuplicate(self,nums):
        seen = {}
        for num in nums:
            if num in seen:
                return True 

            seen[num]=1

        return False

# creating object and calling function
nums = [1, 2, 3, 1]
solution = Answer()
result = solution.containsDuplicate(nums)
print(result)
