class Solution:
    def twoSum (self, nums , target):
        seen = {}
        for i , num in enumerate(nums):
            required = target - num

            if required in seen:
                return[seen[required],i]

            seen[num] = i

# calling the class and function

target = 4
nums = [1,3,2,56,45,4,3,6,8,9]
c1 = Solution()
result = c1.twoSum(nums,target)
print(result)
